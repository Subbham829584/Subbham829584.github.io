{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (Local Server)",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (Direct File)",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Launch Edge (Local Server)",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Launch Edge (Direct File)",
            "file": "${workspaceFolder}/index.html"
        }
    ]
}